<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the harness build. The clear element drops any feed
  configured globally on the machine so the restore resolves from exactly one
  known source and cannot be influenced by a developer's ~/.nuget/NuGet.Config.

  This only controls where packages come from; which versions are allowed is
  fixed by packages.lock.json plus the locked-mode restore in
  setup_toolchain.sh.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
